```env
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/privora

PRIVORA_MAX_EMAILS=100
PRIVORA_MAX_EMAIL_BODY_LENGTH=10000

PRIVORA_ENABLE_EMAIL_DISCOVERY=true
PRIVORA_ENABLE_IDENTITY_VAULT=true

PRIVORA_GMAIL_CREDENTIALS_PATH=credentials.json
PRIVORA_GMAIL_TOKEN_PATH=token.json
```